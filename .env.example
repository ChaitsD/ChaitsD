# Server-only. Never prefix these secrets with VITE_. Generate a unique SESSION_SECRET.
SESSION_SECRET=
DATABASE_PATH=.data/maygrey.sqlite
UPLOAD_DIR=.data/uploads
APP_ORIGIN=http://localhost:5173
API_PORT=3001
PAYMENT_MODE=mock
# Only enable behind exactly one trusted reverse proxy:
TRUST_PROXY=0
# Set for initial CLI admin creation; remove ADMIN_PASSWORD afterward.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=MAYGREY Admin
# Reserved for a future live Razorpay adapter; live checkout is currently blocked.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
